{
  "device_args": {
    "idx": 0,
    "role": "trainer_aggregator",
    "start": true,
    "logging": true,
    "accelerator": "gpu",
    "devices": "auto",
    "is_container": false
  },
  "network_args": {
    "ip": "127.0.0.1",
    "port": 45000,
    "neighbors": "127.0.0.1:45001 127.0.0.1:45002 127.0.0.1:45003",
    "interface": "eth0",
    "discovery_protocol": "simple",
    "discovery_port": 44000
  },
  "federation_args": {
    "round": 0
  },
  "data_args": {
    "dataset": "CIFAR10",
    "iid": false,
    "partition_selection": "dirichlet",
    "partition_parameter": 0.5,
    "number_sub": 4,
    "samples_per_label": 250
  },
  "model_args": {
    "model": "ResNet18"
  },
  "training_args": {
    "trainer": "lightning",
    "epochs": 2,
    "batch_size": 32,
    "optimizer": "adam",
    "learning_rate": 0.001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "scheduler": "steplr",
    "step_size": 10,
    "gamma": 0.1
  },
  "aggregator_args": {
    "algorithm": "FedAvg",
    "aggregation_timeout": 120,
    "pseudo_aggregation": {
      "enabled": true,
      "ema_alpha": 0.25
    }
  },
  "defense_args": {
    "reputation": {
      "enabled": false
    }
  },
  "adversarial_args": {
    "attack_params": {
      "attacks": "No Attack"
    }
  },
  "scenario_args": {
    "rounds": 50,
    "name": "cifar10_resnet18_pseudo_agg",
    "controller": "nebula-test",
    "federation": "DFL",
    "random_seed": 42,
    "n_nodes": 4,
    "matrix": []
  },
  "tracking_args": {
    "log_dir": "./logs",
    "config_dir": "./config",
    "metrics_dir": "./metrics",
    "model_dir": "./models"
  }
}
